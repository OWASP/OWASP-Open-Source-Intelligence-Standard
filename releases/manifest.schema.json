{
  "$comment": "Validated as JSON Schema Draft 2020-12 by scripts/validate_assets.py.",
  "title": "OOSIS Release Manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "release_id",
    "asset",
    "version",
    "status",
    "release_date",
    "scope",
    "runtime",
    "canonical_files",
    "validation",
    "quality_checks",
    "scope_notes"
  ],
  "properties": {
    "manifest_version": {"const": "0.1"},
    "release_id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
    "asset": {"const": "OOVS"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["released", "superseded"]},
    "release_date": {"type": "string", "format": "date"},
    "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "tag": {"type": ["string", "null"], "minLength": 1},
    "scope": {"type": "string", "minLength": 20},
    "runtime": {
      "type": "object",
      "required": ["python", "dependencies", "validation_command"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "validation_command": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "canonical_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "role", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["normative", "machine-readable", "test", "example", "informative", "governance", "validation"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": ["command", "result", "date"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "result": {"const": "passed"},
        "date": {"type": "string", "format": "date"},
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "quality_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "result", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "result": {"const": "passed"},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["identifier_stability", "supersedes"],
      "properties": {
        "identifier_stability": {"type": "string", "minLength": 10},
        "supersedes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "scope_notes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}

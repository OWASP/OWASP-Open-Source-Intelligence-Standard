{
  "$comment": "Validated as JSON Schema Draft 2020-12 by scripts/validate_assets.py.",
  "title": "OOVS v0.1 Acceptance-Test Catalogue",
  "type": "object",
  "required": ["spec_version", "title", "tests"],
  "properties": {
    "spec_version": {"const": "0.1.0"},
    "title": {"const": "OOVS v0.1 Foundational Acceptance Tests"},
    "tests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/test"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "test": {
      "type": "object",
      "required": [
        "id",
        "requirement_ref",
        "title",
        "target_types",
        "preconditions",
        "sample_method",
        "steps",
        "expected_evidence",
        "pass_criteria",
        "failure_conditions",
        "safety_notes"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^OOVS-v0\\.1\\.0-T[0-9]{2}$"},
        "requirement_ref": {"type": "string", "pattern": "^OOVS-v0\\.1\\.0-[0-9]{2}$"},
        "title": {"type": "string", "minLength": 1},
        "target_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["workflow", "product"]}
        },
        "preconditions": {"$ref": "#/$defs/strings"},
        "sample_method": {"type": "string", "minLength": 20},
        "steps": {"$ref": "#/$defs/strings"},
        "expected_evidence": {"$ref": "#/$defs/strings"},
        "pass_criteria": {"$ref": "#/$defs/strings"},
        "failure_conditions": {"$ref": "#/$defs/strings"},
        "safety_notes": {"$ref": "#/$defs/strings"}
      },
      "additionalProperties": false
    }
  }
}

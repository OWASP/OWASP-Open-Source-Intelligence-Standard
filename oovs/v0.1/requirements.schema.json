{
  "$comment": "Validated as JSON Schema Draft 2020-12 by scripts/validate_assets.py.",
  "title": "OOVS v0.1 Requirement Catalogue",
  "type": "object",
  "required": [
    "spec_version",
    "release_status",
    "title",
    "level",
    "canonical_markdown",
    "requirements"
  ],
  "properties": {
    "spec_version": {"const": "0.1.0"},
    "release_status": {"const": "released"},
    "title": {"const": "OWASP OSINT Verification Standard Foundational Requirements"},
    "level": {"const": "L1"},
    "canonical_markdown": {"const": "standard.md"},
    "requirements": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/requirement"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "reference": {
      "type": "object",
      "required": ["id", "title", "url", "relationship"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "relationship": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "applicability": {
      "type": "object",
      "required": ["mode", "applies_when", "not_applicable_when"],
      "properties": {
        "mode": {"enum": ["always", "conditional"]},
        "applies_when": {"$ref": "#/$defs/non_empty_string_array"},
        "not_applicable_when": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": ["procedure", "pass_criteria", "failure_conditions"],
      "properties": {
        "procedure": {"$ref": "#/$defs/non_empty_string_array"},
        "pass_criteria": {"$ref": "#/$defs/non_empty_string_array"},
        "failure_conditions": {"$ref": "#/$defs/non_empty_string_array"}
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "ordinal",
        "level",
        "family",
        "title",
        "objective",
        "normative_statement",
        "applicability",
        "high_consequence_required",
        "evidence",
        "assessment",
        "exceptions",
        "test_refs",
        "references",
        "review_status"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^OOVS-v0\\.1\\.0-[0-9]{2}$"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 10},
        "level": {"const": "L1"},
        "family": {
          "enum": [
            "purpose_and_authority",
            "collection",
            "provenance",
            "source_and_claim",
            "corroboration_and_confidence",
            "analytic_transparency",
            "rights_and_safeguarding",
            "ai_and_automation",
            "dissemination_and_action",
            "governance_and_improvement"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 20},
        "normative_statement": {"type": "string", "minLength": 80},
        "applicability": {"$ref": "#/$defs/applicability"},
        "high_consequence_required": {"type": "boolean"},
        "evidence": {"$ref": "#/$defs/non_empty_string_array"},
        "assessment": {"$ref": "#/$defs/assessment"},
        "exceptions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "test_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^OOVS-v0\\.1\\.0-T[0-9]{2}$"}
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/reference"}
        },
        "source_notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "review_status": {"const": "released"}
      },
      "additionalProperties": false
    }
  }
}

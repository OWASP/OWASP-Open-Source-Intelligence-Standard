{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owasp.org/oosis/ottm/0.1/technique-record.schema.json",
  "title": "OOSIS Technique Record 0.1",
  "type": "object",
  "required": ["spec_version", "id", "name", "status", "domains", "mission_uses", "lifecycle_stages", "inputs", "outputs", "reliability", "tool_capability_classes", "mappings", "limitations", "references"],
  "properties": {
    "spec_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^OTTM-[A-Z]+-[0-9]{3}$"},
    "name": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "candidate", "stable", "deprecated"]},
    "domains": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "mission_uses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "lifecycle_stages": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["mission", "collection", "processing", "fusion", "analysis", "action", "learning"]}
    },
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "reliability": {
      "type": "object",
      "required": ["validation", "failure_modes"],
      "properties": {
        "validation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "source_volatility": {"enum": ["low", "moderate", "high"]}
      },
      "additionalProperties": false
    },
    "tool_capability_classes": {"type": "array", "items": {"type": "string"}},
    "mappings": {"type": "object"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "references": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}}
  },
  "additionalProperties": false
}
